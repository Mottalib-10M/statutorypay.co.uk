---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/redundancy-pay/" title="UK statutory redundancy pay calculator 2026/27" width="100%" height="1150" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the UK redundancy pay calculator 2026/27 on your site" description="Embed the UK statutory redundancy pay calculator on your own site for free: one iframe to copy, no sign-up, no tracking, Great Britain and Northern Ireland caps kept up to date." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the redundancy pay calculator</h1>
    <p class="mt-3 text-lg text-navy-700">Copy one line of code. Union branches, advice centres, HR intranets and newsrooms use it to let people check a redundancy letter against the law.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Terms: keep the credit link under the calculator visible, do not change the widget, and accept it as it is, without warranty. When the cap changes each April the embedded calculator changes with it, with nothing to do on your side.</p>
    <p>Your visitors’ inputs never reach us: the calculation happens in their browser and the iframe sets no cookie. Questions: <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/redundancy-pay/" title="UK statutory redundancy pay calculator 2026/27" width="100%" height="1150" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
