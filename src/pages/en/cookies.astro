---
import PageLayout from '../../layouts/PageLayout.astro';
import { CONTACT_EMAIL, LAST_UPDATED, SITE_NAMES } from '../../data/site-config';
import { route } from '../../i18n/routes';
const lang = 'en';
---
<PageLayout title={`Cookies on ${SITE_NAMES[lang]}: none set today, how to check`} description="Cookies on UK Work Rights: the calculators set none and the site loads no tracker today. What would change if measurement were added, and how your consent would be asked first." lang={lang} noindex={true} breadcrumbs={[{ label: 'Cookies' }]} showAuthor={false}>
  <div class="prose prose-slate max-w-none">
    <h1>Cookies</h1>
    <p>This page completes the <a href={route('privacy', lang)}>privacy policy</a>.</p>
    <h2>Nothing stored today</h2><p>The calculators run in your browser and write no cookie. No analytics, advertising or social media script is loaded. You can check it in your browser’s developer tools, under Storage.</p>
    <h2>If that changes</h2><p>Should audience measurement or advertising be added, a banner will ask for your choice before anything loads, will let you refuse as easily as accept, and this page will list each cookie with its purpose and lifetime.</p>
    <p>Questions: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. Updated: {LAST_UPDATED}.</p>
  </div>
</PageLayout>
