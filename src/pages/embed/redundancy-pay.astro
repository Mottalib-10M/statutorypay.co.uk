---
/** Embeddable page (iframe): calculator only, no navigation. noindex, out of the sitemap (astro.config). */
import '../../styles/global.css';
import RedundancyCalculator from '../../components/calc/RedundancyCalculator';
import { SITE_URL } from '../../data/site-config';
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>UK redundancy pay calculator 2026/27 (widget)</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}/en/redundancy-pay-calculator/`} />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <RedundancyCalculator client:load compact={true} />
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}/en/redundancy-pay-calculator/`} target="_blank" rel="noopener" class="underline">UK Work Rights</a> · calculated in your browser</p>
  </body>
</html>
